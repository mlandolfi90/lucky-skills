FORMAT_VERSION="1"
ADAPTER_ID="codex-hooks"
HOOK_SUPPORT="PARTIAL"
MODE="ADVISORY"
COMMON_EVENTS="SESSION_START,BEFORE_WRITE,AFTER_WRITE,BEFORE_PUSH,SESSION_END"
UNSUPPORTED_EVENTS="AFTER_FAILURE"
CONFIG_TEMPLATE="hooks.json"
CONFIG_TARGET=".codex/hooks.json"
CONFIG_MODE="MERGE_HOOKS"
RUNTIME="skills/configurar-hooks/scripts/run_hook.py"
OFF_SWITCH="LIFECYCLE_HOOKS_ENABLED=0"
