FORMAT_VERSION="1"
ADAPTER_ID="claude-code-hooks"
HOOK_SUPPORT="SUPPORTED"
MODE="ADVISORY"
COMMON_EVENTS="SESSION_START,BEFORE_WRITE,AFTER_WRITE,BEFORE_PUSH,AFTER_FAILURE,SESSION_END"
UNSUPPORTED_EVENTS="NONE"
CONFIG_TEMPLATE="hooks.json"
CONFIG_TARGET=".claude/settings.json"
CONFIG_MODE="MERGE_HOOKS"
RUNTIME="skills/configurar-hooks/scripts/run_hook.py"
OFF_SWITCH="LIFECYCLE_HOOKS_ENABLED=0"
