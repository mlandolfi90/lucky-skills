        <mxCell id="panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#d8d8d8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="2260" y="190" width="460" height="1008" as="geometry"/></mxCell>
        <mxCell id="pl1" value="Cómo se lee" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="2290" y="212" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="pl2" value="&lt;b&gt;Flecha llena:&lt;/b&gt; A está en el REQUIRES de B. Es contrato — la publicación no deja sellar B si falta el tag de A en la versión exigida.&lt;br&gt;&lt;br&gt;&lt;b&gt;Flecha punteada:&lt;/b&gt; lo mismo, pero el dibujo la manda por afuera para no cruzar toda la hoja.&lt;br&gt;&lt;br&gt;&lt;b&gt;Borde grueso:&lt;/b&gt; de esa skill cuelgan cuatro o más." style="text;html=1;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2290" y="248" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="pl3" value="Las seis familias" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="2290" y="392" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="sw1" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=30;" vertex="1" parent="1"><mxGeometry x="2290" y="432" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="sl1" value="&lt;b&gt;Cimiento&lt;/b&gt; — medir antes de tocar" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2326" y="432" width="370" height="20" as="geometry"/></mxCell>
        <mxCell id="sw2" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=30;" vertex="1" parent="1"><mxGeometry x="2290" y="464" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="sl2" value="&lt;b&gt;Escalera del cambio&lt;/b&gt; — hacerlo y cerrarlo" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2326" y="464" width="370" height="20" as="geometry"/></mxCell>
