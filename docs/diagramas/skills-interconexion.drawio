        <mxCell id="sl3" value="&lt;b&gt;Arquitectura y diseño&lt;/b&gt; — dónde va y qué forma tiene" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2326" y="496" width="370" height="20" as="geometry"/></mxCell>
        <mxCell id="sw4" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=30;" vertex="1" parent="1"><mxGeometry x="2290" y="528" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="sl4" value="&lt;b&gt;Catálogo y flota&lt;/b&gt; — nacer, sellar, adoptar, avisar" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2326" y="528" width="370" height="20" as="geometry"/></mxCell>
        <mxCell id="sw5" value="" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=30;" vertex="1" parent="1"><mxGeometry x="2290" y="560" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="sl5" value="&lt;b&gt;Operación y entrega&lt;/b&gt; — secretos, target, deploy" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2326" y="560" width="370" height="20" as="geometry"/></mxCell>
        <mxCell id="sw6" value="" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=30;" vertex="1" parent="1"><mxGeometry x="2290" y="592" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="sl6" value="&lt;b&gt;Sesión y equipo&lt;/b&gt; — tono, reparto, coordinación" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2326" y="592" width="370" height="20" as="geometry"/></mxCell>
        <mxCell id="pl4" value="Lo que las flechas no muestran" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="2290" y="636" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="pl5" value="El REQUIRES es la mitad dura. La otra mitad son las &lt;b&gt;citas&lt;/b&gt;: una skill nombra a otra en su texto para decir dónde termina su jurisdicción. Ahí el grafo es mucho más denso —122 citas entre 37 skills— y tiene dos ejes:" style="text;html=1;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2290" y="670" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="hub1" value="&lt;b&gt;cambio&lt;/b&gt; — citada por &lt;b&gt;24&lt;/b&gt; de 37&lt;div style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;todo trabajo es un tramo de cambio&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;arcSize=14;fillColor=#dae8fc;strokeColor=#3b5f94;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2290" y="748" width="400" height="44" as="geometry"/></mxCell>
        <mxCell id="hub2" value="&lt;b&gt;cierre&lt;/b&gt; — citada por &lt;b&gt;15&lt;/b&gt; de 37&lt;div style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;todo tramo termina en un recibo&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;arcSize=14;fillColor=#dae8fc;strokeColor=#3b5f94;strokeWidth=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2290" y="800" width="400" height="44" as="geometry"/></mxCell>
        <mxCell id="hub3" value="&lt;b&gt;crisol&lt;/b&gt;, &lt;b&gt;disenar&lt;/b&gt; y &lt;b&gt;modo-fixes&lt;/b&gt; — 7 cada una" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;arcSize=14;fillColor=#f0f0f0;strokeColor=#c8c8c8;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2290" y="852" width="400" height="32" as="geometry"/></mxCell>
        <mxCell id="pl6" value="Por eso las ocho de abajo a la izquierda no están sueltas: &lt;i&gt;madrina&lt;/i&gt;, &lt;i&gt;ley-viva&lt;/i&gt;, &lt;i&gt;cargar-reglas&lt;/i&gt;, &lt;i&gt;podar-v2&lt;/i&gt;, &lt;i&gt;red-de-desarrollo&lt;/i&gt;, &lt;i&gt;entonar&lt;/i&gt;, &lt;i&gt;delegar&lt;/i&gt; y &lt;i&gt;estilar&lt;/i&gt; no exigen nada ni son exigidas — se enlazan solo por cita. Es a propósito: se adoptan una por una, sin arrastrar el resto del catálogo." style="text;html=1;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#3d3d3d;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2290" y="900" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="pl7" value="37 skills · 34 dependencias declaradas · 5 capas&#10;lucky-skills @ main · medido el 2026-09-22" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#8a8a8a;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2290" y="1130" width="400" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
